<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.snmpbar" path="/org/gnome/shell/extensions/snmpbar/">
    
    <key name="topbar-source" type="s">
      <default>'total'</default>
      <summary>Quelle für die Top-Bar Anzeige</summary>
      <description>'total' für aggregierte Gesamtleistung oder 'if_&lt;index&gt;' für eine spezifische Einzelschnittstelle.</description>
    </key>

    <key name="panel-position" type="s">
      <default>'right'</default>
      <summary>Position im GNOME Panel</summary>
      <description>'right' (Systemstatus), 'center' (neben der Uhr), 'left' (bei Aktivitäten).</description>
    </key>

    <key name="show-graph" type="b">
      <default>true</default>
      <summary>Mini-Graph in der Bar anzeigen</summary>
      <description>Ob der Sparkline-Verlaufsgraph im Panel gezeichnet werden soll.</description>
    </key>

    <key name="show-numbers" type="b">
      <default>true</default>
      <summary>Zahlenwerte in der Bar anzeigen</summary>
      <description>Ob Download/Upload-Werte als Text im Panel stehen sollen.</description>
    </key>

    <key name="show-dropdown-graphs" type="b">
      <default>true</default>
      <summary>Graphen im Dropdown-Menü anzeigen</summary>
      <description>Ob vergrößerte Verlaufsgraphen für Gesamt- und Einzelschnittstellen im Menü gezeichnet werden sollen.</description>
    </key>

    <key name="color-download" type="s">
      <default>'#3584e4'</default>
      <summary>Farbe für Download / Downstream</summary>
      <description>Hex-Farbwert für Download-Label und Graph.</description>
    </key>

    <key name="color-upload" type="s">
      <default>'#33d17a'</default>
      <summary>Farbe für Upload / Upstream</summary>
      <description>Hex-Farbwert für Upload-Label und Graph.</description>
    </key>

    <key name="menu-text-color" type="s">
      <default>'#1a1a1a'</default>
      <summary>Schriftfarbe im Dropdown-Menü</summary>
      <description>Hex-Farbcode für kontrastreiche Darstellung (Standard: Dunkel/Schwarz).</description>
    </key>

    <!-- Rückwärtskompatible Einzelfelder -->
    <key name="connection-name" type="s">
      <default>'Gateway'</default>
      <summary>Name der primären Verbindung</summary>
      <description>Bezeichnung des Geräts.</description>
    </key>

    <key name="aggregated-name" type="s">
      <default>'Load-Balancer Gesamt'</default>
      <summary>Bezeichnung der aggregierten Leistung</summary>
      <description>Name der rechnerisch aggregierten Gesamtsumme.</description>
    </key>

    <key name="host" type="s">
      <default>'192.0.2.1'</default>
      <summary>Router / Gateway IP</summary>
      <description>IP-Adresse des primären Geräts.</description>
    </key>

    <key name="community" type="s">
      <default>'public'</default>
      <summary>SNMP Community String</summary>
      <description>Read-Community für SNMP.</description>
    </key>

    <key name="snmp-version" type="s">
      <default>'v2c'</default>
      <summary>SNMP Version</summary>
      <description>'v1', 'v2c', 'v3'.</description>
    </key>

    <key name="refresh-interval" type="i">
      <default>3</default>
      <summary>Abfrage-Intervall in Sekunden</summary>
      <description>Häufigkeit der Abfragen.</description>
    </key>

    <key name="interfaces-json" type="s">
      <default>'[{"id":"vdsl","name":"VDSL (INTERNET)","index":65,"icon":"network-wired-symbolic","show_graph":true},{"id":"wwan","name":"5G (INET_WWAN)","index":93,"icon":"network-cellular-signal-excellent-symbolic","show_graph":true},{"id":"gpon","name":"Glasfaser (GPON)","index":400010,"icon":"network-transmit-receive-symbolic","show_graph":true}]'</default>
      <summary>Konfigurierte Interfaces</summary>
      <description>JSON-Array der überwachten Interfaces.</description>
    </key>

    <!-- Multi-Verbindungs-Konfiguration -->
    <key name="connections-json" type="s">
      <default>'[{"id":"conn_1","name":"Gateway","aggregated_name":"Load-Balancer Gesamt","host":"192.0.2.1","community":"public","version":"v2c","interval":3,"interfaces":[{"id":"vdsl","name":"VDSL (INTERNET)","index":65,"icon":"network-wired-symbolic","show_graph":true},{"id":"wwan","name":"5G (INET_WWAN)","index":93,"icon":"network-cellular-signal-excellent-symbolic","show_graph":true},{"id":"gpon","name":"Glasfaser (GPON)","index":400010,"icon":"network-transmit-receive-symbolic","show_graph":true}]}]'</default>
      <summary>Multi-Verbindungs-Konfiguration</summary>
      <description>JSON-Array aller SNMP-Verbindungen mit jeweils eigenen Interfaces.</description>
    </key>

  </schema>
</schemalist>
